# Copy to .env and fill in. .env is gitignored, never commit it.

# Merchant payout address. The live x402 path stays OFF and /api/commit returns
# 501 until this is set. Any address you control is fine for local testing.
MERCHANT_WALLET_ADDRESS=

# Local Anvil mainnet fork. Start it with: cd rail/fork && ./start.sh
# Without this the demo runs the deterministic simulation and labels itself
# DETERMINISTIC DEMO, which is correct behaviour, not a bug.
FORK_RPC=http://127.0.0.1:8545

# Key the facilitator signs settlement with. On the fork, use Anvil's public
# default account 0 below. It is a well-known test key and holds nothing.
# NEVER put a real mainnet private key here.
FACILITATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Only needed if the demo agent clients call a model.
DEEPSEEK_API_KEY=

# Set this only after Dewa has sent the real 0.20 XSGD mainnet settlement.
# Until then the site must render nothing. Never invent a hash.
# MAINNET_SETTLEMENT_TX=

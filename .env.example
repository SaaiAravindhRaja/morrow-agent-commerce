# Copy to .env and fill in:
#   cp .env.example .env
# Never commit .env. Never paste keys into chat.

# --- Required for localhost demo (fork) ---

# Merchant payout address. Public address only. Current demo payTo:
MERCHANT_WALLET_ADDRESS=0x22F2BD6f2c2289FA42429A8487D391f07feFe54A

# Local Anvil mainnet fork. Start it with: cd rail/fork && ./start.sh
FORK_RPC=http://127.0.0.1:8545

# Fork facilitator only. This is Anvil account 0, a well-known empty test key.
# Do not replace this with a mainnet key.
FACILITATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Needed for the Atlas CLI agent.
DEEPSEEK_API_KEY=

# Already-sent 0.20 XSGD mainnet settlement (the one-shot, not the encore).
MAINNET_SETTLEMENT_TX=0xd365489a08ff00f17c816e174cb8fd5d79c604a5db95159d1fd53244a047b7d2

# --- Laptop encore only (option 1: each successful click sends real 0.20 XSGD) ---
# Leave ENCORE_MAINNET=0 until a throwaway wallet is funded and the encore
# code exists. Default off. Hosted Vercel must never read these keys.

ENCORE_MAINNET=0
SETTLE_RPC=https://api.avax.network/ext/bc/C/rpc

# Throwaway payer. Generate locally, do not type it in chat:
#   cast wallet new
# Then send ~1-2 XSGD and a little AVAX to that address from MetaMask.
# Put 0x + 64 hex here. Not the burned 0xfCD4 wallet.
ENCORE_PAYER_PRIVATE_KEY=

# Same merchant as above, unless you use another address you control.
ENCORE_PAY_TO=0x22F2BD6f2c2289FA42429A8487D391f07feFe54A
